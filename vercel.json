{
    "version": 2,
    "builds": [
        {
            "src": "server/index.js",
            "use": "@vercel/node"
        }
    ],
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "server/index.js"
        },
        {
            "src": "/bio/(.*)",
            "dest": "server/index.js"
        },
        {
            "src": "/uploads/(.*)",
            "dest": "server/index.js"
        },
        {
            "src": "/(.*)",
            "dest": "server/index.js"
        }
    ],
    "env": {
        "KOLOSAL_API_KEY": "@kolosal_api_key"
    }
}